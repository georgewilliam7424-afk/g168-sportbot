# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Free API key from https://www.football-data.org/client/register
FOOTBALL_DATA_API_KEY=

# Comma-separated football-data.org competition codes to track.
# Common free-tier codes: PL (Premier League), CL (Champions League),
# PD (La Liga), BL1 (Bundesliga), SA (Serie A), FL1 (Ligue 1), DED (Eredivisie),
# PPL (Primeira Liga), ELC (Championship)
COMPETITIONS=PL,PD,BL1,SA,FL1

# How many days ahead to pull fixtures for
FIXTURE_WINDOW_DAYS=7
